rules_version = '2';

// =============================================================================
// Century Golf Partners — Core Fundamentals Self-Assessment
// Firestore security rules
// -----------------------------------------------------------------------------
// Paste this whole file into:
//   Firebase Console -> Firestore Database -> Rules  ->  Publish
//
// The shape of the deal:
//   * Any signed-in visitor (including anonymous assessment takers) may CREATE
//     one submission document. That is all they can do.
//   * Nobody can read, edit, or delete submissions except accounts you have
//     explicitly listed in the /admins collection.
//   * A taker cannot read back even their OWN submission. That is deliberate —
//     it means a leaked page URL never exposes another club's results.
// =============================================================================

function isAdmin() {
  return request.auth != null
      && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
}

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Assessment submissions
    // ---------------------------------------------------------------------
    match /submissions/{docId} {

      // Admins only. Takers get nothing back.
      allow read: if isAdmin();

      // Anyone signed in may submit, but the document has to look like a real
      // submission. This blocks junk writes and stops anyone using your
      // Firestore as free storage.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll([
                         'club', 'takerName', 'level', 'pctOfRange',
                         'earnedPoints', 'answered', 'answers', 'submittedAt'
                       ])
                    && request.resource.data.club is string
                    && request.resource.data.club.size() > 0
                    && request.resource.data.club.size() <= 120
                    && request.resource.data.takerName is string
                    && request.resource.data.takerName.size() > 0
                    && request.resource.data.takerName.size() <= 120
                    && request.resource.data.level in ['101', '201', '301', '401']
                    && request.resource.data.pctOfRange is int
                    && request.resource.data.pctOfRange >= 0
                    && request.resource.data.pctOfRange <= 100
                    && request.resource.data.answered is int
                    && request.resource.data.answered > 0
                    && request.resource.data.answered <= 100
                    && request.resource.data.answers is list
                    && request.resource.data.answers.size() <= 100
                    && request.resource.data.submittedAt == request.time;

      // Submissions are a permanent record. Nobody edits them from the web,
      // including you — make corrections in the Firebase console instead, so
      // an edit is always a deliberate act.
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Admin allow-list
    // ---------------------------------------------------------------------
    // One document per admin. Document ID = that user's Auth UID.
    // Create these by hand in the Firebase console. Contents don't matter —
    // existence is what grants access — but putting the email in the document
    // makes the list readable six months from now.
    //
    //   admins/AbC123xyzUID   ->   { email: "jcreighton@centurygolf.com" }
    //
    // Readable by admins so the dashboard could show the list later.
    // Never writable from the web: adding an admin must happen in the console.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // Everything else is closed.
    // ---------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
