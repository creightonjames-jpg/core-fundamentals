rules_version = '2';

// =============================================================================
// Century Golf Partners — Membership Core Fundamentals
// Firestore security rules  ·  published in the Firebase console
//
// ACCESS MODEL — one Club cannot see another Club's work.
//
// Every Club has a real Firebase Auth account whose password is its PIN:
//
//     toledo-country-club@clubs.centurygolf.com   /   six digits
//
// Firebase verifies that PIN on its own servers. The rules below then read the
// email address out of the resulting token and compare it to the `clubSlug`
// stored on each document. So access is decided by the database, not by the
// page — a Club that pokes at the API directly, or edits the JavaScript, still
// gets nothing but its own records.
//
// The membership team signs in with its own PIN, on the shared account
// admin@team.centurygolf.com, and reads everything. Named individual accounts
// can be added instead, or as well, via /admins/{uid}.
//
// Note the asymmetry on purpose: a Club PIN opens one Club, the team PIN opens
// all twenty-six plus the filing controls, so the team PIN is longer.
//
// Nobody else reads anything. There is no open read left anywhere.
//
// BEFORE PUBLISHING THESE RULES, three things must be true, or Clubs mid-
// assessment will be locked out of work they have already done:
//   1. the 26 Club accounts exist in Authentication  ->  Users
//   2. the team account admin@team.centurygolf.com exists
//   3. every existing submissions/ and drafts/ document carries `clubSlug`
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // The membership team, two ways.
    //
    // The shared team account is recognised by its address, exactly as a Club
    // is — so a team PIN works the moment the account exists, with no UID to
    // look up and paste. Whoever knows that PIN is the team.
    //
    // /admins/{uid} remains for NAMED individual accounts, added by hand in the
    // console. Use those when you want to know who looked at what; nothing in
    // the app can add one.
    function isTeamAccount() {
      return request.auth != null
          && 'email' in request.auth.token
          && request.auth.token.email is string
          && request.auth.token.email.lower() == 'admin@team.centurygolf.com';
    }

    function isAdmin() {
      return isTeamAccount()
          || (request.auth != null
              && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // True when the caller signed in as exactly this Club. Guarded carefully:
    // an anonymous token has no email at all, and reaching for a missing key
    // would fail open in a language with looser semantics than this one.
    function isClub(slug) {
      return request.auth != null
          && slug is string
          && slug.size() > 0
          && 'email' in request.auth.token
          && request.auth.token.email is string
          && request.auth.token.email.lower() == slug + '@clubs.centurygolf.com';
    }

    // -----------------------------------------------------------------------
    // Submitted assessments — a Club reads its own; the team reads all.
    // Content is permanent either way.
    // -----------------------------------------------------------------------
    match /submissions/{docId} {

      allow read: if isAdmin() || isClub(resource.data.clubSlug);

      // A Club may only file under its own name. clubSlug is what every later
      // read is authorised against, so it has to be nailed down on the way in.
      allow create: if isClub(request.resource.data.clubSlug)
                    && request.resource.data.keys().hasAll([
                         'club', 'clubSlug', 'takerName', 'cfId', 'level', 'pctOfRange',
                         'earnedPoints', 'answered', 'answers', 'submittedAt'
                       ])
                    && request.resource.data.club is string
                    && request.resource.data.club.size() > 0
                    && request.resource.data.club.size() <= 120
                    && request.resource.data.takerName is string
                    && request.resource.data.takerName.size() > 0
                    && request.resource.data.takerName.size() <= 1000
                    && request.resource.data.cfId is int
                    && request.resource.data.cfId >= 1
                    && request.resource.data.cfId <= 50
                    && request.resource.data.level in ['101', '201', '301', '401']
                    && request.resource.data.pctOfRange is int
                    && request.resource.data.pctOfRange >= 0
                    && request.resource.data.pctOfRange <= 100
                    && request.resource.data.answered is int
                    && request.resource.data.answered > 0
                    && request.resource.data.answered <= 300
                    && request.resource.data.answers is list
                    && request.resource.data.answers.size() <= 300
                    && request.resource.data.submittedAt == request.time;

      // Archiving and soft-deleting are the membership team's filing actions, so
      // they now require an admin — a Club cannot hide its own bad result, and a
      // passer-by cannot flip anyone's flags. Content is still untouchable: only
      // these three keys may change, whoever is asking.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['archived', 'deleted', 'statusAt'])
                    && (!('archived' in request.resource.data)
                        || request.resource.data.archived is bool)
                    && (!('deleted' in request.resource.data)
                        || request.resource.data.deleted is bool)
                    && request.resource.data.statusAt == request.time;

      // Real deletion happens in the Firebase console, deliberately.
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Drafts — work in progress, one document per Club per Fundamental.
    // Only the Club that owns it may read or write it. Updatable by design:
    // that is what makes "stop now, come back tomorrow" possible across 233
    // questions.
    // -----------------------------------------------------------------------
    match /drafts/{docId} {

      allow read: if isAdmin() || isClub(resource.data.clubSlug);

      // The id is derived from the Club and the fundamental, so it is pinned to
      // the slug too. Otherwise one Club could create a document at another
      // Club's id and quietly break their resume.
      allow create: if isClub(request.resource.data.clubSlug)
                    && docId.matches('^' + request.resource.data.clubSlug + '--cf[0-9]+$')
                    && validDraft();

      // Both sides checked: the document must already be this Club's, and must
      // still be this Club's afterwards. A Club cannot hand its draft to
      // another Club, or take one.
      allow update: if isClub(resource.data.clubSlug)
                    && isClub(request.resource.data.clubSlug)
                    && validDraft();

      allow delete: if false;
    }

    function validDraft() {
      return request.resource.data.club is string
          && request.resource.data.club.size() > 0
          && request.resource.data.club.size() <= 120
          && request.resource.data.cfId is int
          && request.resource.data.cfId >= 1
          && request.resource.data.cfId <= 50
          && request.resource.data.updatedAt == request.time
          && (!('teamMembers' in request.resource.data)
              || request.resource.data.teamMembers.size() <= 1000)
          && (!('answered' in request.resource.data)
              || (request.resource.data.answered is int
                  && request.resource.data.answered >= 0
                  && request.resource.data.answered <= 300));
    }

    // -----------------------------------------------------------------------
    // Admin allow-list, for NAMED accounts. One document per person, the
    // document id being that person's Auth UID. Added by hand in the console —
    // nothing in the app can grant itself admin. The shared team account does
    // not need an entry here; it is recognised by its address above.
    // -----------------------------------------------------------------------
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
