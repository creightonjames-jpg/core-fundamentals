rules_version = '2';

// =============================================================================
// Century Golf Partners — Membership Core Fundamentals
// Firestore security rules  ·  published in the Firebase console
//
// ACCESS MODEL
// The results dashboard (admin.html) is gated by a PIN checked in the browser.
// A browser-side PIN cannot gate a database, so reads below are open to any
// visitor. Treat submissions and drafts as public information.
//
// To make results private again:
//   1. change  allow read: if true;  to  allow read: if isAdmin();
//   2. create a Firebase Auth account for each viewer
//   3. add a document at /admins/{that user's UID}
//   4. replace the PIN gate in admin.html with a real sign-in
// The isAdmin() function and /admins rules below are already in place.
//
// What holds regardless: the CONTENT of a submitted assessment can never be
// edited or erased through the web app, and malformed writes are rejected. The
// dashboard can archive or soft-delete a submission — both are reversible flags
// that hide a row without touching what it says.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // -----------------------------------------------------------------------
    // Submitted assessments — permanent, immutable
    // -----------------------------------------------------------------------
    match /submissions/{docId} {

      // Open by design — see ACCESS MODEL above.
      allow read: if true;

      // takerName holds the list of participating team members, so it is allowed
      // to be long — a club may list a dozen people.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll([
                         'club', 'takerName', 'cfId', 'level', 'pctOfRange',
                         'earnedPoints', 'answered', 'answers', 'submittedAt'
                       ])
                    && request.resource.data.club is string
                    && request.resource.data.club.size() > 0
                    && request.resource.data.club.size() <= 120
                    && request.resource.data.takerName is string
                    && request.resource.data.takerName.size() > 0
                    && request.resource.data.takerName.size() <= 1000
                    && request.resource.data.cfId is int
                    && request.resource.data.cfId >= 1
                    && request.resource.data.cfId <= 50
                    && request.resource.data.level in ['101', '201', '301', '401']
                    && request.resource.data.pctOfRange is int
                    && request.resource.data.pctOfRange >= 0
                    && request.resource.data.pctOfRange <= 100
                    && request.resource.data.answered is int
                    && request.resource.data.answered > 0
                    && request.resource.data.answered <= 300
                    && request.resource.data.answers is list
                    && request.resource.data.answers.size() <= 300
                    && request.resource.data.submittedAt == request.time;

      // A submitted assessment is a record of what a Club said on a given day.
      // Its CONTENT is permanent: no answer, score, club or date can ever be
      // rewritten from the web. The one thing the dashboard may change is its
      // filing status — archived, or soft-deleted — and nothing else.
      //
      // The diff() check below is the whole protection. It allows a write only
      // if the set of keys that actually changed is a subset of these three.
      // An attempt to touch 'answers', 'level', 'club' or anything else in the
      // same write is rejected outright, so a tampered request cannot smuggle a
      // content edit in alongside an archive.
      //
      // Note what this does and does not defend against. Because there is no
      // real sign-in (see ACCESS MODEL above), anyone who finds the site can
      // flip these two flags. That is survivable by design: both are reversible
      // from the dashboard in one click and neither destroys anything.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['archived', 'deleted', 'statusAt'])
                    && (!('archived' in request.resource.data)
                        || request.resource.data.archived is bool)
                    && (!('deleted' in request.resource.data)
                        || request.resource.data.deleted is bool)
                    && request.resource.data.statusAt == request.time;

      // Hard delete stays off. Turning it on without a real sign-in would let
      // any visitor erase every Club's results, permanently.
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Drafts — work in progress, one document per Club per Fundamental.
    // Overwritten continuously as a club works. Deliberately updatable: that is
    // what makes "stop now, come back tomorrow" possible across 233 questions.
    // -----------------------------------------------------------------------
    match /drafts/{docId} {
      allow read: if true;

      allow create, update: if request.auth != null
                    && request.resource.data.club is string
                    && request.resource.data.club.size() > 0
                    && request.resource.data.club.size() <= 120
                    && request.resource.data.cfId is int
                    && request.resource.data.cfId >= 1
                    && request.resource.data.cfId <= 50
                    && request.resource.data.updatedAt == request.time
                    && (!('teamMembers' in request.resource.data)
                        || request.resource.data.teamMembers.size() <= 1000)
                    && (!('answered' in request.resource.data)
                        || (request.resource.data.answered is int
                            && request.resource.data.answered >= 0
                            && request.resource.data.answered <= 300));

      // Drafts are never removed. On submit they are flagged, not erased, so a
      // Club can reopen an assessment and re-run it later.
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Admin allow-list — reserved for the private-results path described above
    // -----------------------------------------------------------------------
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
