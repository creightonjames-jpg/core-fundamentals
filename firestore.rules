rules_version = '2';

// =============================================================================
// Century Golf Partners — Core Fundamentals Self-Assessment
// Firestore security rules  ·  published in the Firebase console
//
// ACCESS MODEL
// The results dashboard (admin.html) is gated by a PIN checked in the browser.
// A browser-side PIN cannot gate a database, so the submissions read rule below
// is open to any visitor. Treat submissions as public information.
//
// To make results private again:
//   1. change  allow read: if true;  to  allow read: if isAdmin();
//   2. create a Firebase Auth account for each viewer
//   3. add a document at /admins/{that user's UID}
//   4. replace the PIN gate in admin.html with a real sign-in
// The isAdmin() function and /admins rules below are already in place for this.
//
// What stays true either way: submissions cannot be edited or deleted by
// anyone through the web app, and junk writes are rejected.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /submissions/{docId} {

      // Open by design — see ACCESS MODEL above.
      allow read: if true;

      // takerName holds the list of participating team members, so it is allowed
      // to be long — a club may list a dozen people.
      // Anyone signed in (takers are signed in anonymously) may submit, but the
      // document has to look like a real submission. This blocks junk writes and
      // stops anyone using your Firestore as free storage.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll([
                         'club', 'takerName', 'level', 'pctOfRange',
                         'earnedPoints', 'answered', 'answers', 'submittedAt'
                       ])
                    && request.resource.data.club is string
                    && request.resource.data.club.size() > 0
                    && request.resource.data.club.size() <= 120
                    && request.resource.data.takerName is string
                    && request.resource.data.takerName.size() > 0
                    && request.resource.data.takerName.size() <= 1000
                    && request.resource.data.level in ['101', '201', '301', '401']
                    && request.resource.data.pctOfRange is int
                    && request.resource.data.pctOfRange >= 0
                    && request.resource.data.pctOfRange <= 100
                    && request.resource.data.answered is int
                    && request.resource.data.answered > 0
                    && request.resource.data.answered <= 100
                    && request.resource.data.answers is list
                    && request.resource.data.answers.size() <= 100
                    && request.resource.data.submittedAt == request.time;

      // Submissions are a permanent record. Nobody edits them from the web,
      // including you — make corrections in the Firebase console instead, so
      // an edit is always a deliberate act.
      allow update, delete: if false;
    }

    // Reserved for the private-results path described above. Not used today.
    // Never writable from the web: adding a viewer happens in the console.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
